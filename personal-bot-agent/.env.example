# Personal Unified Brain — Environment Configuration Template
# কোনো আসল API Key বা গোপন তথ্য এখানে লিখবেন না।
# Codespaces বা লোকাল পরিবেশে এটি কপি করে .env তৈরি করে ব্যবহার করুন।

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

APP_HOST=127.0.0.1
APP_PORT=8000

GUARDRAIL_MAX_STEPS=10
GUARDRAIL_TIMEOUT_SEC=60
ALLOW_LIVE_FETCH=true
